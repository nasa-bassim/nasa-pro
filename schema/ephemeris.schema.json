{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ephemeris for one body seen from one lunar site",
  "type": "object",
  "additionalProperties": false,
  "required": ["site", "body", "lat", "lon_e", "samples"],
  "properties": {
    "site": { "type": "string", "minLength": 1 },
    "name": { "type": "string" },
    "body": { "enum": ["sun", "earth"] },
    "lat": { "type": "number", "minimum": -90, "maximum": 90 },
    "lon_e": { "type": "number", "minimum": -360, "maximum": 360 },
    "source": { "type": "string" },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["t", "az", "el"],
        "properties": {
          "t": { "type": "string" },
          "az": { "type": "number", "minimum": 0, "maximum": 360 },
          "el": { "type": "number", "minimum": -90, "maximum": 90 },
          "flags": { "type": "string", "maxLength": 2 }
        }
      }
    }
  }
}
